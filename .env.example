# Supabase project API settings (Settings -> API in the dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by app/api/account/route.ts to delete a user's auth
# account. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by the send-reminders Edge Function (set via `supabase secrets set`
# for the deployed function; only needed here for local reference).
RESEND_API_KEY=your-resend-api-key
